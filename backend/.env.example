# ==============================================================================
# VYUMI "Shop With Me" (Feature 5) - Environment Configuration
# ==============================================================================

# Server Network Configuration
PORT=3001
NODE_ENV=development

# Allowed Frontend Origins (comma-separated for multi-domain support)
# In production, specify exact origins (e.g. https://shop.vyumi.com)
FRONTEND_URL=http://localhost:5173

# Publicly accessible URL for the backend API and uploads
API_PUBLIC_URL=http://localhost:3001

# Storage Configuration
# SQLite database path relative to backend directory or absolute path
DATABASE_PATH=data/shop-with-me.sqlite

# Room Lifecycle & Quotas
# Maximum participants allowed per room (default: 50)
MAX_PARTICIPANTS_PER_ROOM=50
# Room lifetime in hours before expiration (default: 168 hours = 7 days)
ROOM_TTL_HOURS=168
# Cleanup timer frequency for deleting expired rooms in milliseconds (default: 1 hour)
ROOM_CLEANUP_INTERVAL_MS=3600000

# Structured Logging
# Options: fatal, error, warn, info, debug, trace, silent (default: info)
LOG_LEVEL=info

# Optional Local AI Integration (Ollama)
# Leave blank to run 100% deterministically without external AI models.
# Example: http://localhost:11434
OLLAMA_URL=
# Model tag if Ollama is enabled (default: llama3.2)
OLLAMA_MODEL=llama3.2

# Optional Redis Multi-Node Clustering & Distributed Rate-Limiting
# Leave blank to use high-performance in-memory defaults.
# Example: redis://localhost:6379
REDIS_URL=
